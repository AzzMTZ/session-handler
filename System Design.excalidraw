    {
      "id": "_J-D5dKctQJERcmOshq00",
      "type": "text",
      "x": 199.72222222222217,
      "y": -660.8333333333334,
      "width": 978.079345703125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0",
      "roundness": null,
      "seed": 1607192575,
      "version": 744,
      "versionNonce": 1827083836,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787790016084,
      "link": null,
      "locked": false,
      "text": "Requirements:\n- Consumers should be able to search user events over all field combinations\n- The system should store all up to date user sessions, saving every login, update and logout event\n- The system should handle high events throughput\n- The system should allow low latency and high consistency on user session searches\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Requirements:\n- Consumers should be able to search user events over all field combinations\n- The system should store all up to date user sessions, saving every login, update and logout event\n- The system should handle high events throughput\n- The system should allow low latency and high consistency on user session searches\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3EYtctOV3ECRuUyWdIr3k",
      "type": "text",
      "x": 200.6111111111112,
      "y": -444.9444444444444,
      "width": 348.51983642578125,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 1981546399,
      "version": 767,
      "versionNonce": 1233362853,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787791828885,
      "link": null,
      "locked": false,
      "text": "Data Models:\n- Session { \n    id: string; \n    tenantId: string;\n    username: string; \n    ip: string;\n    tags: string[]; \n    loggedIn: DateTime; \n    loggedOut?: DateTime; \n    lastUpdated: DateTime;\n}\n- SessionEvent {\n    id: string; \n    sessionId: string;\n    tenantId: string;\n    username: string; \n    ip: string; \n    tags?: string[]; \n    timestamp: DateTime; \n    type: LOGIN|UPDATE|LOGOUT;\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Data Models:\n- Session { \n    id: string; \n    tenantId: string;\n    username: string; \n    ip: string;\n    tags: string[]; \n    loggedIn: DateTime; \n    loggedOut?: DateTime; \n    lastUpdated: DateTime;\n}\n- SessionEvent {\n    id: string; \n    sessionId: string;\n    tenantId: string;\n    username: string; \n    ip: string; \n    tags?: string[]; \n    timestamp: DateTime; \n    type: LOGIN|UPDATE|LOGOUT;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Oorr6tsTVRJclz9LQP79x",
      "type": "text",
      "x": 1262.166666666667,
      "y": -683.6666666666667,
      "width": 926.2392578125,
      "height": 775,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 1132793841,
      "version": 1424,
      "versionNonce": 264449893,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787791769151,
      "link": null,
      "locked": false,
      "text": "API Endpoints:\n- POST /sessions/\n    body: { tenantId: string; username: string; ip: string; tags: string[]; timestamp: DateTime }\n    returns: Session with 201 statuscode\n- PUT /sessions/:tenantId/:username/:ip/\n    body: { tags: string[]; timestamp: DateTime }\n    returns: Session with 200 statuscode\n- DELETE /sessions/:tenantId/:username/:ip/?timestamp=DateTime\n    returns: 204 statuscode\n- POST /sessions/search/\n    body: {\n        tenantId?: string;\n        username?: string;\n        ip?: string;\n        loggedIn?: { before?: DateTime; after?: DateTime };\n        loggedOut?: { before?: DateTime; after?: DateTime };\n        lastUpdated?: { before?: DateTime; after?: DateTime };\n        tags?: string[];\n    }\n    returns: Session[] with 200 statuscode\n- POST /session-events/search/\n    body: {\n        sessionId?: string;\n        tenantId?: string;\n        username?: string;\n        ip?: string;\n        tags?: string[];\n        timestamp?: { before?: DateTime; after?: DateTime }; \n        type?: LOGIN|UPDATE|LOGOUT;\n    }\n    returns: SessionEvent[] with 200 statuscode",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API Endpoints:\n- POST /sessions/\n    body: { tenantId: string; username: string; ip: string; tags: string[]; timestamp: DateTime }\n    returns: Session with 201 statuscode\n- PUT /sessions/:tenantId/:username/:ip/\n    body: { tags: string[]; timestamp: DateTime }\n    returns: Session with 200 statuscode\n- DELETE /sessions/:tenantId/:username/:ip/?timestamp=DateTime\n    returns: 204 statuscode\n- POST /sessions/search/\n    body: {\n        tenantId?: string;\n        username?: string;\n        ip?: string;\n        loggedIn?: { before?: DateTime; after?: DateTime };\n        loggedOut?: { before?: DateTime; after?: DateTime };\n        lastUpdated?: { before?: DateTime; after?: DateTime };\n        tags?: string[];\n    }\n    returns: Session[] with 200 statuscode\n- POST /session-events/search/\n    body: {\n        sessionId?: string;\n        tenantId?: string;\n        username?: string;\n        ip?: string;\n        tags?: string[];\n        timestamp?: { before?: DateTime; after?: DateTime }; \n        type?: LOGIN|UPDATE|LOGOUT;\n    }\n    returns: SessionEvent[] with 200 statuscode",
      "autoResize": true,
      "lineHeight": 1.25
    },
